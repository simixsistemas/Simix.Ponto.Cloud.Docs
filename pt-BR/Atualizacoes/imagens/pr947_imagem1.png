"},"Publication:13fc05314e90":{"__typename":"Publication","id":"13fc05314e90","theme":{"__typename":"PublicationTheme","accentColor":{"__typename":"ColorValue","rgb":""}}},"LinkedAccounts:c4064e24fa5b":{"__typename":"LinkedAccounts","mastodon":null,"id":"c4064e24fa5b"},"NewsletterV3:6cd0f33b70b3":{"__typename":"NewsletterV3","id":"6cd0f33b70b3","type":"NEWSLETTER_TYPE_AUTHOR","slug":"c4064e24fa5b","name":"c4064e24fa5b","collection":null,"user":{"__ref":"User:c4064e24fa5b"}},"User:c4064e24fa5b":{"__typename":"User","id":"c4064e24fa5b","name":"ABP.IO","username":"abpio","newsletterV3":{"__ref":"NewsletterV3:6cd0f33b70b3"},"linkedAccounts":{"__ref":"LinkedAccounts:c4064e24fa5b"},"isSuspended":false,"imageId":"1*zuBcmpCLDGAVZUw-fM4lCA.png","customDomainState":{"__typename":"CustomDomainState","live":{"__typename":"CustomDomain","domain":"abpio.medium.com"}},"hasSubdomain":true,"verifications":{"__typename":"VerifiedInfo","isBookAuthor":false},"socialStats":{"__typename":"SocialStats","followerCount":368,"followingCount":1,"collectionFollowingCount":1},"bio":"Open Source ABP Framework is a complete infrastructure to create modern web applications by following the best practices & conventions of software development.","membership":null,"allowNotes":true,"viewerEdge":{"__ref":"UserViewerEdge:userId:c4064e24fa5b-viewerId:lo_77bf66ecfcda"},"twitterScreenName":""},"Paragraph:946188931405_0":{"__typename":"Paragraph","id":"946188931405_0","name":"e29f","type":"H3","href":null,"layout":null,"metadata":null,"text":"EF Core 8 — Enhancements to JSON column mapping","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_1":{"__typename":"Paragraph","id":"946188931405_1","name":"2a36","type":"P","href":null,"layout":null,"metadata":null,"text":"In this article, we will examine the enhancements introduced in EF Core 8 for the JSON column feature, building upon the foundation laid by JSON columns in Entity Framework Core 7.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":140,"end":179,"href":"https:\u002F\u002Fcommunity.abp.io\u002Fposts\u002Fjson-columns-in-entity-framework-core-7-cjaom76j","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_2":{"__typename":"Paragraph","id":"946188931405_2","name":"d242","type":"H3","href":null,"layout":null,"metadata":null,"text":"The entity classes we will be using in the article","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_3":{"__typename":"Paragraph","id":"946188931405_3","name":"73b9","type":"PRE","href":null,"layout":null,"metadata":null,"text":"public class Person\n{\n    public int Id { get; set; }\n    [Required]\n    public string Name { get; set; }\n    [Required]\n    public ContactDetails ContactDetails { get; set; }\n}\n\npublic class ContactDetails\n{\n    public List\u003CAddress\u003E Addresses { get; set; } = new();\n    public string? Phone { get; set; }\n}\n\npublic class Address\n{\n    public Address(string street, string city, string postcode, string country)\n    {\n        Street = street;\n        City = city;\n        Postcode = postcode;\n        Country = country;\n    }\n\n    public string Street { get; set; }\n    public string City { get; set; }\n    public string Postcode { get; set; }\n    public string Country { get; set; }\n    public bool IsMainAddress { get; set; }\n}","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"csharp"},"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_4":{"__typename":"Paragraph","id":"946188931405_4","name":"1d50","type":"H3","href":null,"layout":null,"metadata":null,"text":"The DbContext class we will be using in the article","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_5":{"__typename":"Paragraph","id":"946188931405_5","name":"76ee","type":"PRE","href":null,"layout":null,"metadata":null,"text":"public class AppDbContext : DbContext\n{\n    public DbSet\u003CPerson\u003E Persons { get; set; } = null!;\n\n    protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)\n    {\n#if SQLSERVER\n        optionsBuilder.UseSqlServer(\"Server=localhost;Database=EfCore8Json;Trusted_Connection=True;TrustServerCertificate=True\");\n#elif SQLITE\n        optionsBuilder.UseSqlite(\"Data Source=EfCore8Json.db\");\n#endif\n        base.OnConfiguring(optionsBuilder);\n    }\n\n    protected override void OnModelCreating(ModelBuilder modelBuilder)\n    {\n        modelBuilder.Entity\u003CPerson\u003E(b =\u003E\n        {\n            b.ToTable(\"Persons\");\n            b.HasKey(x =\u003E x.Id);\n            b.Property(x =\u003E x.Name).IsRequired();\n            b.OwnsOne(x =\u003E x.ContactDetails, cb =\u003E\n            {\n                cb.ToJson();\n                cb.Property(x =\u003E x.Phone);\n                cb.OwnsMany(x =\u003E x.Addresses);\n            });\n        });\n\n        base.OnModelCreating(modelBuilder);\n    }\n}","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"csharp"},"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_6":{"__typename":"Paragraph","id":"946188931405_6","name":"50fd","type":"H3","href":null,"layout":null,"metadata":null,"text":"Translate element access into JSON arrays","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_7":{"__typename":"Paragraph","id":"946188931405_7","name":"9e8a","type":"P","href":null,"layout":null,"metadata":null,"text":"EF Core 8 supports indexing in JSON arrays when executing queries. For example, the following query returns individuals whose first address is the main address in the database:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_8":{"__typename":"Paragraph","id":"946188931405_8","name":"78d4","type":"PRE","href":null,"layout":null,"metadata":null,"text":"var query = dbContext.Persons\n    .Select(x =\u003E x.ContactDetails.Addresses[0])\n    .Where(x =\u003E x.IsMainAddress == true)\n    .ToListAsync();","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"javascript"},"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_9":{"__typename":"Paragraph","id":"946188931405_9","name":"d0ce","type":"P","href":null,"layout":null,"metadata":null,"text":"The generated SQL query is as follows when using SQL Server:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_10":{"__typename":"Paragraph","id":"946188931405_10","name":"39ac","type":"PRE","href":null,"layout":null,"metadata":null,"text":"SELECT JSON_QUERY([p].[ContactDetails], '$.Addresses[0]'), [p].[Id]\nFROM [Persons] AS [p]\nWHERE CAST(JSON_VALUE([p].[ContactDetails], '$.Addresses[0].IsMainAddress') AS bit) = CAST(1 AS bit)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"sql"},"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_11":{"__typename":"Paragraph","id":"946188931405_11","name":"23a4","type":"BQ","href":null,"layout":null,"metadata":null,"text":"Note: If you attempt to access an index that is outside of the array, it will return null.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":0,"end":90,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_12":{"__typename":"Paragraph","id":"946188931405_12","name":"6516","type":"H3","href":null,"layout":null,"metadata":null,"text":"JSON Columns for SQLite","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_13":{"__typename":"Paragraph","id":"946188931405_13","name":"a3ac","type":"P","href":null,"layout":null,"metadata":null,"text":"In EF Core 7, JSON column mapping was supported for Azure SQL\u002FSQL Server. In EF Core 8, this support has been extended to include SQLite as well.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_14":{"__typename":"Paragraph","id":"946188931405_14","name":"ea69","type":"H3","href":null,"layout":null,"metadata":null,"text":"Queries into JSON columns","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_15":{"__typename":"Paragraph","id":"946188931405_15","name":"66fa","type":"P","href":null,"layout":null,"metadata":null,"text":"The following query returns individuals whose first address is the main address in the database:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_16":{"__typename":"Paragraph","id":"946188931405_16","name":"56d1","type":"PRE","href":null,"layout":null,"metadata":null,"text":"var query = dbContext.Persons\n    .Select(x =\u003E x.ContactDetails.Addresses[0])\n    .Where(x =\u003E x.IsMainAddress == true)\n    .ToListAsync();","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"javascript"},"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_17":{"__typename":"Paragraph","id":"946188931405_17","name":"8aee","type":"P","href":null,"layout":null,"metadata":null,"text":"The generated SQL query is as follows when using SQLite:","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_18":{"__typename":"Paragraph","id":"946188931405_18","name":"88b2","type":"PRE","href":null,"layout":null,"metadata":null,"text":"SELECT \"p\".\"ContactDetails\" -\u003E\u003E '$.Addresses[0]', \"p\".\"Id\"\nFROM \"Persons\" AS \"p\"\nWHERE \"p\".\"ContactDetails\" -\u003E\u003E '$.Addresses[0].IsMainAddress' = 0","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":{"__typename":"CodeBlockMetadata","mode":"AUTO","lang":"sql"},"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_19":{"__typename":"Paragraph","id":"946188931405_19","name":"1fdc","type":"H3","href":null,"layout":null,"metadata":null,"text":"References","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:946188931405_20":{"__typename":"Paragraph","id":"946188931405_20","name":"0273","type":"ULI","href":null,"layout":null,"metadata":null,"text":"EF Core 8 — Enhancements to JSON column mapping","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":0,"end":47,"href":"https:\u002F\u002Flearn.microsoft.com\u002Fen-us\u002Fef\u002Fcore\u002Fwhat-is-new\u002Fef-core-8.0\u002Fwhatsnew#enhancements-to-json-column-mapping","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"CollectionViewerEdge:collectionId:13fc05314e90-viewerId:lo_77bf66ecfcda":{"__typename":"CollectionViewerEdge","id":"collectionId:13fc05314e90-viewerId:lo_77bf66ecfcda","isEditor":false,"isMuting":false},"UserViewerEdge:userId:c4064e24fa5b-viewerId:lo_77bf66ecfcda":{"__typename":"UserViewerEdge","id":"userId:c4064e24fa5b-viewerId:lo_77bf66ecfcda","isMuting":false},"PostViewerEdge:postId:31e89b693023-viewerId:l